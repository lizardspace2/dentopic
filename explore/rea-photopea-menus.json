{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://www.photopea.com/", "query": [] },
  "environment": {
    "viewport": { "width": 1600, "height": 900, "device_scale_factor": 1 },
    "color_scheme": "dark"
  },
  "capture": {
    "after_each_step": ["dom"],
    "at_end": ["url", "screenshot", "dom"],
    "events": []
  },
  "actions": [
    { "step_id": "wait_load", "action": "wait_for_timeout", "duration_ms": 8000 },
    { "step_id": "start_app", "action": "click", "locator": { "kind": "css", "selector": "#ccont > button" }, "timeout_ms": 15000 },
    { "step_id": "wait_app", "action": "wait_for_timeout", "duration_ms": 20000 },
    { "step_id": "m_file", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(1)" }, "timeout_ms": 8000 },
    { "step_id": "m_edit", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(2)" }, "timeout_ms": 5000 },
    { "step_id": "m_image", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(3)" }, "timeout_ms": 5000 },
    { "step_id": "m_layer", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(4)" }, "timeout_ms": 5000 },
    { "step_id": "m_select", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(5)" }, "timeout_ms": 5000 },
    { "step_id": "m_filter", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(6)" }, "timeout_ms": 5000 },
    { "step_id": "m_view", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(7)" }, "timeout_ms": 5000 },
    { "step_id": "m_window", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(8)" }, "timeout_ms": 5000 },
    { "step_id": "m_more", "action": "click", "locator": { "kind": "css", "selector": ".topbar span:nth-of-type(1) button:nth-of-type(9)" }, "timeout_ms": 5000 },
    { "step_id": "end_wait", "action": "wait_for_timeout", "duration_ms": 800 }
  ]
}
