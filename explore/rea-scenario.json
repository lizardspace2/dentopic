{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "http://localhost:5175/login", "query": [] },
  "environment": {
    "viewport": { "width": 1500, "height": 880, "device_scale_factor": 1 },
    "color_scheme": "dark"
  },
  "secrets": [
    { "secret_id": "email", "environment_variable": "DP_USER" },
    { "secret_id": "pass", "environment_variable": "DP_PASS" }
  ],
  "capture": {
    "after_each_step": ["url", "screenshot"],
    "at_end": ["url", "screenshot", "dom"],
    "events": ["console", "page-errors", "network"],
    "network": { "request_body": false, "response_body": false, "header_values": false }
  },
  "actions": [
    {
      "step_id": "fill_email",
      "action": "fill",
      "locator": { "kind": "css", "selector": "input[type='email']" },
      "value": { "source": "secret", "secret_id": "email" }
    },
    {
      "step_id": "fill_pass",
      "action": "fill",
      "locator": { "kind": "css", "selector": "input[type='password']" },
      "value": { "source": "secret", "secret_id": "pass" }
    },
    {
      "step_id": "submit",
      "action": "click",
      "locator": { "kind": "css", "selector": "button[type='submit']" }
    },
    { "step_id": "wait_login", "action": "wait_for_timeout", "duration_ms": 4000 },
    {
      "step_id": "goto_studio",
      "action": "goto",
      "destination": { "url": "http://localhost:5175/studio", "query": [] },
      "wait_until": "load"
    },
    { "step_id": "wait_studio", "action": "wait_for_timeout", "duration_ms": 2000 },
    {
      "step_id": "open_file_menu",
      "action": "click",
      "locator": { "kind": "css", "selector": "button:has-text('Fichier')" },
      "timeout_ms": 15000
    },
    { "step_id": "wait_menu", "action": "wait_for_timeout", "duration_ms": 800 },
    {
      "step_id": "close_menu",
      "action": "press",
      "locator": { "kind": "css", "selector": "body" },
      "key": "Escape"
    },
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 800 }
  ]
}
