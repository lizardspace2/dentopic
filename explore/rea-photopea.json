{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://www.photopea.com/", "query": [] },
  "environment": {
    "viewport": { "width": 1600, "height": 900, "device_scale_factor": 1 },
    "color_scheme": "dark"
  },
  "capture": {
    "after_each_step": ["url"],
    "at_end": ["url", "screenshot", "dom"],
    "events": ["console", "page-errors"]
  },
  "actions": [
    { "step_id": "wait_load", "action": "wait_for_timeout", "duration_ms": 8000 },
    {
      "step_id": "start_app",
      "action": "click",
      "locator": { "kind": "css", "selector": "#ccont > button" },
      "timeout_ms": 15000
    },
    { "step_id": "wait_app", "action": "wait_for_timeout", "duration_ms": 20000 }
  ]
}
